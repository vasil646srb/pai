/* pai client — design tokens
   Concept: the product's core idea is a compression gradient — raw fragments
   (cold, exact) rising through summarization into abstract memory (warm,
   approximate). That cold→warm ramp is the one signature: it appears in the
   header stack, in level badges, and in the tree explorer. Everything else
   stays quiet and instrument-like. */

:root {
  --bg: #0a0d11;
  --surface: #12161c;
  --surface-2: #191f27;
  --surface-3: #212832;
  --border: #262d38;
  --border-soft: #1c222b;

  --text: #e9e7e1;
  --text-dim: #8b93a1;
  --text-faint: #545d6b;

  --accent-live: #e8a33d;   /* warm — live/active context */
  --accent-live-dim: #6b5327;
  --accent-cold: #4fa8c4;   /* cold — raw storage / exact data */
  --accent-cold-dim: #24404b;

  --danger: #d9615f;
  --success: #6cbf8b;

  --mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Helvetica, Arial, sans-serif;

  --radius: 6px;
  --radius-sm: 4px;
}

/* Light theme — same tokens, repainted. Toggled via [data-theme="light"] on
   <html> (see the inline script in index.html's <head>, which sets it
   before first paint to avoid a dark→light flash on load). */
:root[data-theme="light"] {
  --bg: #f4f5f7;
  --surface: #ffffff;
  --surface-2: #eef0f3;
  --surface-3: #e3e6eb;
  --border: #d6dae1;
  --border-soft: #e7e9ed;

  --text: #1c2129;
  --text-dim: #5b6472;
  --text-faint: #8890a0;

  --accent-live: #c97f14;
  --accent-live-dim: #f4e0b8;
  --accent-cold: #2f7f9c;
  --accent-cold-dim: #d6edf4;

  --danger: #c23b39;
  --success: #2f8f5b;
}
:root[data-theme="light"] ::-webkit-scrollbar-thumb { background: var(--surface-3); border-color: var(--bg); }
:root[data-theme="light"] .btn.primary { color: #2a1a02; }
:root[data-theme="light"] .toast { box-shadow: 0 6px 20px rgba(30,34,42,0.14); }
:root[data-theme="light"] .sidebar-backdrop { background: rgba(30,34,42,0.35); }

/* level ramp: level 0 = coldest, level 5+ = warmest */
.lvl-0 { --lvl-color: #4fa8c4; }
.lvl-1 { --lvl-color: #64a8ab; }
.lvl-2 { --lvl-color: #86a887; }
.lvl-3 { --lvl-color: #ab9d64; }
.lvl-4 { --lvl-color: #cf9548; }
.lvl-5 { --lvl-color: #e8a33d; }

* { box-sizing: border-box; }
html, body { height: 100%; overflow: hidden; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

::selection { background: var(--accent-live-dim); color: var(--text); }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--surface-3); border-radius: 6px; border: 2px solid var(--bg); }

button { font-family: inherit; }
input, textarea, select { font-family: inherit; }

a { color: var(--accent-cold); text-decoration: none; }
a:hover { text-decoration: underline; }

code, .mono { font-family: var(--mono); }

/* ---------- shell ---------- */

#app {
  display: grid;
  grid-template-columns: 220px 1fr;
  grid-template-rows: 56px 1fr;
  height: 100vh;      /* fallback for browsers without dvh */
  height: 100dvh;      /* real visible viewport height on mobile (excludes URL bar) */
  height: calc(var(--vvh, 100dvh)); /* set via JS from visualViewport; tracks on-screen keyboard */
}

.topbar {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 0 18px;
  border-bottom: 1px solid var(--border-soft);
  background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
}

.wordmark {
  font-weight: 800;
  font-size: 17px;
  letter-spacing: -0.03em;
  display: flex;
  align-items: baseline;
  gap: 2px;
}
.wordmark .dot { color: var(--accent-live); }

.stack-viz {
  display: flex;
  align-items: center;
  gap: 1px;
  height: 16px;
  border-radius: 3px;
  overflow: hidden;
  flex: 0 0 auto;
  width: 160px;
  background: var(--surface-2);
}
.stack-viz .seg { height: 100%; background: var(--lvl-color); opacity: 0.85; min-width: 2px; }
.stack-label { font-size: 11px; color: var(--text-faint); font-family: var(--mono); white-space: nowrap; }

.topbar-spacer { flex: 1; }

.menu-toggle {
  display: none;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  width: 34px; height: 34px;
  font-size: 16px;
  cursor: pointer;
  flex: 0 0 auto;
}

.theme-toggle {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  width: 32px;
  height: 32px;
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-toggle:hover { border-color: var(--accent-cold); }

.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 40;
}
.sidebar-backdrop.visible { display: block; }

.status-pill {
  display: flex; align-items: center; gap: 6px;
  font-size: 12px; color: var(--text-dim);
  padding: 4px 10px; border: 1px solid var(--border); border-radius: 20px;
  font-family: var(--mono);
}
.status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-faint); }
.status-dot.ok { background: var(--success); }
.status-dot.err { background: var(--danger); }

.sidebar {
  border-right: 1px solid var(--border-soft);
  background: var(--surface);
  padding: 14px 10px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  color: var(--text-dim);
  cursor: pointer;
  font-size: 13px;
  border: 1px solid transparent;
  user-select: none;
}
.nav-item:hover { color: var(--text); background: var(--surface-2); }
.nav-item.active { color: var(--text); background: var(--surface-2); border-color: var(--border); }
.nav-item .ico { width: 14px; text-align: center; opacity: 0.8; font-family: var(--mono); font-size: 12px; }

.nav-section-label {
  font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--text-faint); padding: 14px 12px 4px;
}

.main {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 26px 32px 60px;
  min-width: 0;
  min-height: 0; /* required so a grid child can actually scroll instead of stretching the row */
}
.main:has(#view-chat.active) { padding: 12px 20px; }

.view { display: none; max-width: 1180px; margin: 0 auto; }
.view.active { display: block; }
#view-chat.active { max-width: 100%; }
#view-chat .page-title, #view-chat .page-sub { display: none; }

h1.page-title {
  font-size: 20px; font-weight: 700; letter-spacing: -0.01em;
  margin: 0 0 4px;
}
.page-sub { color: var(--text-dim); font-size: 13px; margin: 0 0 24px; }

/* ---------- generic bits ---------- */

.card {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius);
  padding: 16px;
}

.grid { display: grid; gap: 12px; }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-2 { grid-template-columns: 1fr 1fr; }

@media (max-width: 900px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
}

.stat-card .stat-label {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-faint); margin-bottom: 6px;
}
.stat-card .stat-value {
  font-family: var(--mono); font-size: 22px; font-weight: 600;
}
.stat-card .stat-value.warm { color: var(--accent-live); }
.stat-card .stat-value.cold { color: var(--accent-cold); }

.btn {
  background: var(--surface-3);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 7px 13px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  cursor: pointer;
}
.btn:hover { border-color: var(--text-faint); }
.btn:disabled { opacity: 0.4; cursor: default; }
.btn.primary { background: var(--accent-live); border-color: var(--accent-live); color: #1a1305; font-weight: 600; }
.btn.primary:hover { filter: brightness(1.08); }
.btn.ghost { background: transparent; }
.btn.danger { color: var(--danger); border-color: var(--danger); background: transparent; }
.btn.sm { padding: 4px 9px; font-size: 11.5px; }

.field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
.field label { font-size: 11.5px; color: var(--text-dim); }
.field input[type=text], .field input[type=password], .field input[type=number], .field textarea, .field select {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  outline: none;
}
.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--accent-cold); }
.field textarea { resize: vertical; min-height: 60px; }
.field .hint, .field-hint { font-size: 11px; color: var(--text-faint); }
.opt-tag { font-size: 9.5px; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 400; }

.llm-settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; }
.field-wide { grid-column: 1 / -1; }
.model-row { display: flex; gap: 8px; align-items: center; }
.model-row select { flex: 1; min-width: 0; }
.model-row input[type=text] { flex: 1; min-width: 0; }
.llm-settings-actions { display: flex; align-items: center; gap: 12px; margin-top: 10px; padding-top: 14px; border-top: 1px solid var(--border-soft); }
.llm-status-pill { font-family: var(--mono); font-size: 10.5px; padding: 2px 8px; border-radius: 20px; border: 1px solid var(--border); color: var(--text-dim); }
.llm-status-pill.ok { color: var(--success); border-color: var(--success); background: rgba(108,191,139,0.12); }
.llm-status-pill.off { color: var(--text-faint); }

@media (max-width: 720px) {
  .llm-settings-grid { grid-template-columns: 1fr; }
  .model-row { flex-wrap: wrap; }
}

/* ---------- model picker (search + sortable price/context table) ---------- */

.model-row input[readonly] { cursor: pointer; color: var(--text-dim); }
.model-row input[readonly]:hover { border-color: var(--text-faint); }

.model-picker {
  margin-top: 8px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  overflow: hidden;
}
.model-picker-toolbar {
  display: flex; align-items: center; gap: 10px;
  padding: 8px; border-bottom: 1px solid var(--border-soft);
  background: var(--surface-2);
}
.model-search {
  flex: 1; min-width: 0;
  background: var(--bg); border: 1px solid var(--border); color: var(--text);
  border-radius: var(--radius-sm); padding: 6px 9px; font-size: 12.5px; font-family: inherit;
}
.model-search:focus { border-color: var(--accent-cold); outline: none; }
.model-filter-toggle {
  display: flex; align-items: center; gap: 5px; white-space: nowrap;
  font-size: 11.5px; color: var(--text-dim); cursor: pointer; user-select: none;
}
.model-filter-toggle input { accent-color: var(--accent-cold); }

.model-table-head {
  display: grid; grid-template-columns: 1fr 92px 92px 84px;
  gap: 0; background: var(--surface-2); border-bottom: 1px solid var(--border-soft);
}
.mt-col {
  padding: 7px 9px; font-size: 10.5px; color: var(--text-faint);
  text-transform: uppercase; letter-spacing: 0.03em; cursor: pointer; user-select: none;
  display: flex; align-items: center; gap: 4px; white-space: nowrap;
}
.mt-col:hover { color: var(--text-dim); }
.mt-col.mt-price, .mt-col.mt-ctx { justify-content: flex-end; }
.mt-col.sorted { color: var(--accent-cold); }
.sort-ico { font-size: 9px; opacity: 0.8; }

.model-table-body { max-height: 260px; overflow-y: auto; }
.model-row-item {
  display: grid; grid-template-columns: 1fr 92px 92px 84px;
  padding: 7px 9px; font-size: 12px; cursor: pointer;
  border-bottom: 1px solid var(--border-soft);
}
.model-row-item:last-child { border-bottom: none; }
.model-row-item:hover { background: var(--surface-2); }
.model-row-item.selected { background: var(--accent-cold-dim); }
.model-row-item.selected .mr-id { color: var(--text); font-weight: 600; }
.mr-id { font-family: var(--mono); font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mr-price { text-align: right; font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); }
.mr-price.unknown { color: var(--text-faint); }
.mr-ctx { text-align: right; font-family: var(--mono); font-size: 11px; color: var(--text-faint); }
.model-table-empty { padding: 18px 9px; text-align: center; color: var(--text-faint); font-size: 12px; }

@media (max-width: 520px) {
  .model-table-head, .model-row-item { grid-template-columns: 1fr 68px 68px; }
  .mt-col.mt-ctx, .mr-ctx { display: none; }
}

.tag {
  display: inline-flex; align-items: center; gap: 4px;
  font-family: var(--mono); font-size: 10.5px;
  padding: 2px 7px; border-radius: 20px;
  background: var(--surface-3); color: var(--text-dim);
  border: 1px solid var(--border);
}
.tag.lvl { color: var(--lvl-color); border-color: var(--lvl-color); background: color-mix(in srgb, var(--lvl-color) 12%, transparent); }

.badge-status {
  font-size: 10.5px; font-family: var(--mono); padding: 2px 7px; border-radius: 20px;
  text-transform: lowercase;
}
.badge-status.active { color: var(--success); background: rgba(108,191,139,0.12); }
.badge-status.pinned { color: var(--accent-live); background: rgba(232,163,61,0.14); }
.badge-status.draft { color: var(--text-dim); background: var(--surface-3); }
.badge-status.validated { color: var(--accent-cold); background: rgba(79,168,196,0.12); }
.badge-status.rejected, .badge-status.excluded { color: var(--danger); background: rgba(217,97,95,0.12); }
.badge-status.archived, .badge-status.hidden { color: var(--text-faint); background: var(--surface-2); }

.empty-state {
  text-align: center; padding: 40px 20px; color: var(--text-faint);
  border: 1px dashed var(--border); border-radius: var(--radius);
  font-size: 13px;
}

.section-title {
  font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-faint); margin: 28px 0 10px;
}
.section-title:first-child { margin-top: 0; }

/* ---------- chat ---------- */

.chat-col-full { height: calc(100vh - 82px); }
.chat-col-full { height: calc(100dvh - 82px); }
.chat-col-full { height: calc(var(--vvh, 100dvh) - 82px); }
.chat-col { display: flex; flex-direction: column; border: 1px solid var(--border-soft); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
.chat-toolbar { display: flex; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--border-soft); align-items: center; }
.chat-toolbar select { background: var(--surface-2); border: 1px solid var(--border); color: var(--text); padding: 6px 8px; border-radius: var(--radius-sm); font-size: 12.5px; }
.tok-speed { font-family: var(--mono); font-size: 11px; color: var(--accent-live); min-width: 0; white-space: nowrap; }
.chat-messages { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; }

.msg { max-width: 82%; }
.msg.user { align-self: flex-end; }
.msg.assistant { align-self: flex-start; max-width: 88%; }
.msg .bubble { padding: 10px 13px; border-radius: 10px; font-size: 13.5px; }
.msg.user .bubble { background: var(--accent-cold-dim); border: 1px solid var(--accent-cold); border-bottom-right-radius: 3px; white-space: pre-wrap; }
.msg.assistant .bubble { background: var(--surface-2); border: 1px solid var(--border); border-bottom-left-radius: 3px; }
.msg .meta { font-size: 10.5px; color: var(--text-faint); font-family: var(--mono); margin-top: 4px; }
.msg.user .meta { text-align: right; }

/* markdown rendering inside assistant bubbles */
.bubble .md p { margin: 0 0 8px; }
.bubble .md p:last-child { margin-bottom: 0; }
.bubble .md h1, .bubble .md h2, .bubble .md h3 { margin: 12px 0 6px; line-height: 1.3; }
.bubble .md h1:first-child, .bubble .md h2:first-child, .bubble .md h3:first-child { margin-top: 0; }
.bubble .md ul, .bubble .md ol { margin: 4px 0 8px; padding-left: 20px; }
.bubble .md li { margin: 2px 0; }
.bubble .md code { font-family: var(--mono); font-size: 12px; background: var(--bg); padding: 1px 5px; border-radius: 3px; color: var(--accent-cold); }
.bubble .md pre { background: var(--bg); border: 1px solid var(--border-soft); border-radius: var(--radius-sm); padding: 10px 12px; overflow-x: auto; margin: 6px 0; }
.bubble .md pre code { background: none; padding: 0; color: var(--text); }
.bubble .md blockquote { margin: 6px 0; padding: 2px 12px; border-left: 2px solid var(--accent-cold); color: var(--text-dim); }
.bubble .md a { color: var(--accent-cold); }
.bubble .md strong { color: var(--text); font-weight: 700; }
.bubble .md hr { border: none; border-top: 1px solid var(--border-soft); margin: 10px 0; }
.bubble .md table { border-collapse: collapse; margin: 6px 0; font-size: 12.5px; }
.bubble .md th, .bubble .md td { border: 1px solid var(--border-soft); padding: 4px 8px; }
.msg.assistant.streaming .bubble .md::after { content: "▍"; color: var(--accent-live); animation: blink 1s step-start infinite; }
@keyframes blink { 50% { opacity: 0; } }

.tool-trace { margin-top: 6px; display: flex; flex-direction: column; gap: 4px; }
.tool-call { font-family: var(--mono); font-size: 11px; padding: 6px 9px; background: var(--bg); border: 1px solid var(--border-soft); border-radius: var(--radius-sm); color: var(--text-dim); cursor: pointer; }
.tool-call .tname { color: var(--accent-cold); }
.tool-call pre { margin: 6px 0 0; white-space: pre-wrap; word-break: break-word; color: var(--text-faint); }
.tool-call.live { cursor: default; border-color: var(--accent-live); color: var(--text-dim); }
.tool-call.live .tname { color: var(--accent-live); }
.tool-live-label { color: var(--accent-live); font-style: italic; }
.tool-spin { display: inline-block; width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--border); border-top-color: var(--accent-live); animation: spin 0.7s linear infinite; margin-right: 6px; vertical-align: middle; }

.chat-input-row { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border-soft); align-items: flex-end; }
.chat-input-row textarea { flex: 1; background: var(--surface-2); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius-sm); padding: 9px 11px; font-size: 13.5px; resize: none; min-height: 40px; max-height: 140px; outline: none; }
.chat-input-row textarea:focus { border-color: var(--accent-cold); }

/* reasoning toggle in the chat toolbar */
.reasoning-toggle { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim); cursor: pointer; user-select: none; }
.reasoning-toggle input { accent-color: var(--accent-live); }
.reasoning-effort-select { background: var(--surface-2); border: 1px solid var(--border); color: var(--text); padding: 4px 6px; border-radius: var(--radius-sm); font-size: 11.5px; }
.reasoning-effort-select:disabled { opacity: 0.45; cursor: not-allowed; }

/* chain-of-thought block rendered above the final answer inside an
   assistant bubble — visually distinct (muted, italic, collapsible) so
   it doesn't read as part of the actual reply */
.reasoning-block { margin-bottom: 8px; border: 1px dashed var(--border); border-left: 3px solid var(--accent-live); border-radius: var(--radius-sm); background: var(--bg); }
.reasoning-block-head { display: flex; align-items: center; gap: 6px; padding: 6px 9px; cursor: pointer; user-select: none; font-size: 11px; color: var(--accent-live); font-family: var(--mono); }
.reasoning-block-head .chevron { color: var(--text-faint); font-size: 10px; transition: transform 0.15s ease; }
.reasoning-block.collapsed .reasoning-block-head .chevron { transform: rotate(-90deg); }
.reasoning-block-body { padding: 0 10px 10px; font-size: 12px; line-height: 1.5; color: var(--text-faint); font-style: italic; white-space: pre-wrap; }
.reasoning-block.collapsed .reasoning-block-body { display: none; }
.reasoning-block.streaming .reasoning-block-head::after { content: "· думает…"; color: var(--text-faint); font-style: italic; margin-left: 2px; }

/* image attachments — paperclip button + preview strip above the textarea */
.chat-attach-btn { background: var(--surface-2); border: 1px solid var(--border); color: var(--text-dim); border-radius: var(--radius-sm); width: 38px; height: 38px; font-size: 16px; cursor: pointer; flex-shrink: 0; }
.chat-attach-btn:hover { border-color: var(--accent-cold); color: var(--text); }
.chat-input-col { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.chat-attachments { display: flex; gap: 8px; flex-wrap: wrap; }
.attachment-thumb { position: relative; width: 56px; height: 56px; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border); }
.attachment-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.attachment-thumb .remove { position: absolute; top: 0; right: 0; background: rgba(10,12,16,0.75); color: var(--text); border: none; width: 18px; height: 18px; font-size: 12px; line-height: 1; cursor: pointer; border-radius: 0 0 0 6px; }
.msg.user .attachments { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
.msg.user .attachments img { width: 96px; height: 96px; object-fit: cover; border-radius: 8px; border: 1px solid var(--accent-cold); }

/* collapsible usage widget, docked above the message list */
.chat-usage-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:7px; margin:4px 0 10px; }
.chat-usage-card { border:1px solid var(--border-soft); background:var(--surface-2); border-radius:var(--radius-sm); padding:8px 9px; min-width:0; }
.chat-usage-card span { display:block; font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-faint); margin-bottom:3px; }
.chat-usage-card b { display:block; font-family:var(--mono); font-size:13px; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chat-usage-card small { display:block; margin-top:2px; color:var(--text-faint); font-size:9.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.chat-usage-details { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px 14px; padding:9px 0; border-top:1px solid var(--border-soft); }
.chat-usage-details div { display:flex; justify-content:space-between; gap:10px; font-size:10.5px; color:var(--text-dim); }
.chat-usage-details b { font-family:var(--mono); color:var(--text); font-weight:500; text-align:right; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.usage-widget { border-bottom: 1px solid var(--border-soft); background: var(--surface); flex-shrink: 0; }
.usage-widget-head { display: flex; align-items: center; gap: 10px; padding: 8px 14px; cursor: pointer; user-select: none; }
.usage-widget-head:hover { background: var(--surface-2); }
.usage-widget-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); }
.usage-widget-summary { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); flex: 1; }
.usage-widget-chevron { color: var(--text-faint); font-size: 11px; transition: transform 0.15s ease; }
.usage-widget-body { padding: 4px 14px 14px; }
.usage-widget.collapsed .usage-widget-body { display: none; }
.usage-widget.collapsed .usage-widget-chevron { transform: rotate(-90deg); }
.budget-bar-track { height: 7px; border-radius: 4px; background: var(--surface-3); overflow: hidden; display: flex; margin-bottom: 4px; }
.budget-bar-track .seg { height: 100%; }
.budget-row { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-dim); padding: 3px 0; }
.budget-row .dot { display: inline-block; width: 7px; height: 7px; border-radius: 2px; margin-right: 6px; }
.budget-free { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border-soft); font-family: var(--mono); font-size: 12px; }
.cache-pill { font-family: var(--mono); font-size: 10.5px; padding: 2px 8px; border-radius: 20px; border: 1px solid var(--border); color: var(--text-dim); background: var(--surface-3); flex-shrink: 0; }
.cache-pill.ok { color: var(--success); border-color: var(--success); background: rgba(108,191,139,0.12); }
.cache-pill.warn { color: var(--accent-live); border-color: var(--accent-live); background: rgba(232,163,61,0.14); }
.cache-pill.crit { color: var(--danger); border-color: var(--danger); background: rgba(217,97,95,0.14); }
.cache-detail { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border-soft); font-size: 11px; color: var(--text-dim); }
.cache-status-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.cache-bar-track { flex: 1; min-width: 160px; height: 10px; border-radius: 5px; background: var(--surface-3); overflow: hidden; position: relative; }
.cache-bar-fill { height: 100%; transition: width 0.3s ease; }
.cache-bar-target { position: absolute; top: -2px; bottom: -2px; width: 2px; background: var(--text-faint); }
.cache-status-num { font-family: var(--mono); font-size: 13px; }

/* ---------- memory explorer ---------- */

.explorer-layout { display: grid; grid-template-columns: 320px 1fr; gap: 18px; }

.tree-panel { border: 1px solid var(--border-soft); border-radius: var(--radius); background: var(--surface); padding: 10px; max-height: 640px; overflow-y: auto; }
.tree-toolbar { display: flex; gap: 8px; margin-bottom: 10px; }
.tree-toolbar select { flex: 1; }

.tree-node { font-size: 12.5px; }
.tree-node-row { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: var(--radius-sm); cursor: pointer; }
.tree-node-row:hover { background: var(--surface-2); }
.tree-node-row.selected { background: var(--surface-3); outline: 1px solid var(--border); }
.tree-node-row .twist { width: 12px; color: var(--text-faint); font-size: 10px; text-align: center; }
.tree-node-row .lvl-chip { width: 8px; height: 8px; border-radius: 2px; background: var(--lvl-color); flex: 0 0 auto; }
.tree-node-row .summ { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-dim); }
.tree-node-row .cnt { font-family: var(--mono); font-size: 10px; color: var(--text-faint); }
.tree-children { margin-left: 16px; border-left: 1px solid var(--border-soft); padding-left: 4px; }

.inspector { border: 1px solid var(--border-soft); border-radius: var(--radius); background: var(--surface); padding: 20px; min-height: 300px; }
.inspector-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.inspector-id { font-family: var(--mono); font-size: 15px; }
.inspector-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.kv-grid { display: grid; grid-template-columns: 130px 1fr; gap: 8px 14px; font-size: 12.5px; margin-bottom: 16px; }
.kv-grid .k { color: var(--text-faint); }
.kv-grid .v { font-family: var(--mono); color: var(--text-dim); word-break: break-word; }
.content-block { background: var(--bg); border: 1px solid var(--border-soft); border-radius: var(--radius-sm); padding: 12px; font-size: 12.5px; white-space: pre-wrap; margin-bottom: 12px; max-height: 260px; overflow-y: auto; }
.content-block-label { font-size: 10.5px; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px; letter-spacing: 0.05em; }

.search-row { display: flex; gap: 8px; margin-bottom: 14px; }
.search-row input { flex: 1; }
.search-result { padding: 9px 11px; border: 1px solid var(--border-soft); border-radius: var(--radius-sm); margin-bottom: 6px; cursor: pointer; font-size: 12.5px; }
.search-result:hover { border-color: var(--border); background: var(--surface-2); }
.search-result .sid { font-family: var(--mono); color: var(--accent-cold); font-size: 11px; }
.search-result .snip { color: var(--text-dim); margin-top: 3px; }
.search-result .snip mark { background: var(--accent-live-dim); color: var(--accent-live); border-radius: 2px; padding: 0 1px; }

/* ---------- lists (personas / rules) ---------- */

.persona-card, .rule-card {
  border: 1px solid var(--border-soft); border-radius: var(--radius); background: var(--surface);
  padding: 14px 16px; margin-bottom: 10px;
}
.persona-card-top, .rule-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }

/* ---------- collapsible rules / functions ---------- */
.collapsible-card .collapse-header { cursor: pointer; user-select: none; margin: -2px -4px; padding: 2px 4px; border-radius: var(--radius-sm); }
.collapsible-card .collapse-header:hover { background: var(--surface-2); }
.collapse-heading { min-width: 0; display: flex; align-items: flex-start; gap: 10px; flex-wrap: wrap; }
.collapse-heading .tag { overflow: hidden; text-overflow: ellipsis; }
.collapse-toggle { flex: 0 0 auto; width: 26px; height: 24px; padding: 0; border: 1px solid var(--border-soft); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text-dim); cursor: pointer; font-size: 16px; line-height: 20px; }
.collapse-toggle:hover { border-color: var(--border); color: var(--text); }
.collapse-body { overflow: hidden; max-height: 2000px; opacity: 1; transition: max-height .2s ease, opacity .15s ease, margin-top .2s ease; }
.collapsible-card.is-collapsed .collapse-body { max-height: 0; opacity: 0; margin-top: 0 !important; }
.collapsible-card.is-collapsed { padding-bottom: 12px; }
.persona-name { font-weight: 700; font-size: 14px; }
.persona-id { font-family: var(--mono); color: var(--text-faint); font-size: 11px; margin-left: 8px; }
.persona-desc { color: var(--text-dim); font-size: 12.5px; margin: 6px 0 10px; }
.persona-meta { display: flex; gap: 6px; flex-wrap: wrap; }
.persona-actions { display: flex; gap: 6px; margin-top: 10px; }
.persona-edit-form { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-soft); display: flex; flex-direction: column; gap: 4px; }
.persona-edit-form label { font-size: 10.5px; text-transform: uppercase; color: var(--text-faint); letter-spacing: 0.05em; margin-top: 6px; }
.persona-edit-form input, .persona-edit-form textarea {
  background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
  padding: 7px 9px; border-radius: var(--radius-sm); font-size: 12.5px; width: 100%; outline: none;
}
.persona-edit-form input:focus, .persona-edit-form textarea:focus { border-color: var(--accent-cold); }
.persona-edit-form textarea { resize: vertical; }

.rule-text { font-size: 13px; margin: 8px 0; }
.rule-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 11px; color: var(--text-faint); font-family: var(--mono); }
.rule-actions { display: flex; gap: 6px; margin-top: 10px; }

.filter-row { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
.filter-row select, .filter-row input { max-width: 200px; }

.toast-stack { position: fixed; bottom: 18px; right: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 999; }
.toast { background: var(--surface-3); border: 1px solid var(--border); padding: 10px 14px; border-radius: var(--radius-sm); font-size: 12.5px; box-shadow: 0 6px 20px rgba(0,0,0,0.4); animation: toast-in 0.15s ease-out; }
.toast.err { border-color: var(--danger); color: var(--danger); }
.toast.ok { border-color: var(--success); color: var(--success); }
@keyframes toast-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

.settings-row { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 20px; }
.settings-row .field { margin-bottom: 0; flex: 1; }

.spin { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--border); border-top-color: var(--accent-cold); animation: spin 0.7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- mobile ---------- */

@media (max-width: 720px) {
  #app {
    grid-template-columns: 1fr;
  }

  .menu-toggle { display: block; }

  .wordmark { font-size: 15px; }
  .stack-viz { width: 70px; }
  .stack-label { display: none; }
  .status-pill { font-size: 11px; padding: 3px 8px; }
  .topbar { gap: 10px; padding: 0 10px; }

  .sidebar {
    position: fixed;
    top: 56px;
    left: 0;
    bottom: 0;
    width: 250px;
    max-width: 80vw;
    transform: translateX(-100%);
    transition: transform 0.18s ease-out;
    z-index: 50;
  }
  .sidebar.open { transform: translateX(0); }

  .main {
    padding: 16px 12px 40px;
  }
  .main:has(#view-chat.active) {
    padding: 0;
    overflow: hidden;
  }

  .view { max-width: 100%; }

  .chat-col-full { height: calc(100vh - 56px); }
  .chat-col-full { height: calc(100dvh - 56px); }
  .chat-col-full { height: calc(var(--vvh, 100dvh) - 56px); }
  .chat-toolbar { flex-wrap: wrap; }
  .tok-speed { order: 3; width: 100%; }

  .explorer-layout {
    grid-template-columns: 1fr;
  }

  .grid-4, .grid-3, .grid-2 {
    grid-template-columns: 1fr;
  }

  .kv-grid {
    grid-template-columns: 100px 1fr;
    font-size: 12px;
  }

  .settings-row {
    flex-direction: column;
    align-items: stretch;
  }

  .filter-row select, .filter-row input {
    max-width: none;
    flex: 1 1 140px;
  }
}


/* Usage analytics */
.usage-extra-grid { margin-top: 12px; }
.stat-hint { color: var(--text-faint); font-size: 11px; margin-top: 5px; }
.usage-table-wrap { overflow-x: auto; }
.usage-table { min-width: 760px; }
.usage-row {
  display: grid;
  grid-template-columns: minmax(180px, 2fr) repeat(5, minmax(90px, 1fr));
  gap: 12px;
  align-items: center;
  padding: 9px 10px;
  border-bottom: 1px solid var(--border-soft);
  font-size: 12px;
}
.usage-row:last-child { border-bottom: 0; }
.usage-head { color: var(--text-faint); font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
.usage-row small { display: block; color: var(--text-faint); margin-top: 3px; }
.usage-foot { padding: 9px 10px 2px; color: var(--text-faint); font-size: 11px; }

/* Action log */
.action-log-row { margin-bottom: 8px; padding: 0; }
.action-log-row summary {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  cursor: pointer;
  font-size: 12px;
  list-style: none;
}
.action-log-row summary::-webkit-details-marker { display: none; }
.action-log-row summary > span:nth-child(3) { flex: 1; color: var(--text-dim); }
.action-log-detail { padding: 0 12px 12px; border-top: 1px solid var(--border-soft); }
.action-log-detail pre { max-height: 320px; overflow: auto; font-size: 11px; }

@media (max-width: 900px) { .chat-usage-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .chat-usage-details { grid-template-columns:repeat(2,minmax(0,1fr)); } }
