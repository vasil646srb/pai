<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>pai — персональный ассистент</title>
<script>
  // Applied before the stylesheet paints, so there's no dark→light flash
  // on load. Defaults to light per current design; falls back to
  // whatever the user picked last time.
  (function () {
    var saved = localStorage.getItem("pai.theme");
    document.documentElement.setAttribute("data-theme", saved === "dark" ? "dark" : "light");
  })();
</script>
<link rel="stylesheet" href="/static/style.css?v=__BUILD__" />
</head>
<body>
<div id="app">

  <div class="topbar">
    <button class="menu-toggle" id="menuToggle" aria-label="Меню">☰</button>
    <div class="wordmark">p<span class="dot">a</span>i</div>
    <div class="stack-viz" id="headerStack" title="Узлы по уровням дерева"></div>
    <span class="stack-label" id="headerStackLabel">— узлов</span>
    <div class="topbar-spacer"></div>
    <button class="theme-toggle" id="themeToggle" type="button" title="Переключить тему">☀️</button>
    <div class="status-pill"><span class="status-dot" id="connDot"></span><span id="connLabel">подключение…</span></div>
  </div>

  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="sidebar" id="sidebar">
    <div class="nav-item active" data-view="chat"><span class="ico">▸</span>Чат</div>
    <div class="nav-section-label">Memory Explorer</div>
    <div class="nav-item" data-view="overview"><span class="ico">▸</span>Обзор</div>
    <div class="nav-item" data-view="tree"><span class="ico">▸</span>Дерево / узлы</div>
    <div class="nav-section-label">Управление</div>
    <div class="nav-item" data-view="personas"><span class="ico">▸</span>Персоны</div>
    <div class="nav-item" data-view="skills"><span class="ico">▸</span>Скилы</div>
    <div class="nav-item" data-view="rules"><span class="ico">▸</span>Правила</div>
    <div class="nav-item" data-view="functions"><span class="ico">▸</span>Функции</div>
    <div class="nav-item" data-view="usage"><span class="ico">▸</span>Usage / стоимость</div>
    <div class="nav-item" data-view="actionlog"><span class="ico">▸</span>Лог действий</div>
    <div class="nav-item" data-view="settings"><span class="ico">▸</span>Настройки</div>
  </div>

  <div class="main">

    <!-- ===================== CHAT ===================== -->
    <section class="view active" id="view-chat">
      <h1 class="page-title">Чат</h1>
      <p class="page-sub">Диалог с активной персоной.</p>

      <div class="chat-col chat-col-full">
        <div class="chat-toolbar">
          <select id="chatPersona"></select>
          <select id="chatSpace">
            <option value="personal">personal</option>
            <option value="work">work</option>
            <option value="health">health</option>
            <option value="finance">finance</option>
            <option value="study">study</option>
            <option value="shared">shared</option>
          </select>
          <label class="reasoning-toggle" title="Показывать и запрашивать цепочку рассуждений модели (reasoning tokens)">
            <input type="checkbox" id="chatReasoningToggle" />
            Ризонинг
          </label>
          <select id="chatReasoningEffort" class="reasoning-effort-select" disabled>
            <option value="low">low</option>
            <option value="medium" selected>medium</option>
            <option value="high">high</option>
          </select>
          <span class="tok-speed" id="tokSpeed"></span>
          <div class="topbar-spacer"></div>
          <button class="btn ghost sm" id="btnClearChat">Очистить окно</button>
        </div>

        <div class="usage-widget" id="usageWidget">
          <div class="usage-widget-head" id="usageWidgetHead">
            <span class="usage-widget-title">Статистика текущего ответа</span>
            <span class="usage-widget-summary" id="usageWidgetSummary">ожидание запроса</span>
            <span class="cache-pill" id="cachePill" title="Загрузка KV-кеша"></span>
            <span class="usage-widget-chevron" id="usageWidgetChevron">▾</span>
          </div>
          <div class="usage-widget-body" id="usageWidgetBody">
            <div class="chat-usage-grid" id="chatUsageGrid">
              <div class="chat-usage-card"><span>Context</span><b id="cuContext">—</b><small id="cuContextHint">—</small></div>
              <div class="chat-usage-card"><span>Input</span><b id="cuInput">—</b><small>prompt tokens</small></div>
              <div class="chat-usage-card"><span>Output</span><b id="cuOutput">—</b><small>completion tokens</small></div>
              <div class="chat-usage-card"><span>Reasoning</span><b id="cuReasoning">—</b><small>thinking tokens</small></div>
              <div class="chat-usage-card"><span>Cached</span><b id="cuCached">—</b><small>cached input</small></div>
              <div class="chat-usage-card"><span>Speed</span><b id="cuSpeed">—</b><small>output tokens/sec</small></div>
              <div class="chat-usage-card"><span>TTFT</span><b id="cuTtft">—</b><small>time to first token</small></div>
              <div class="chat-usage-card"><span>Cost</span><b id="cuCost">—</b><small>current turn</small></div>
            </div>
            <div class="chat-usage-details" id="chatUsageDetails">
              <div><span>Модель</span><b id="cuModel">—</b></div>
              <div><span>Всего токенов</span><b id="cuTotal">—</b></div>
              <div><span>LLM-вызовов</span><b id="cuCalls">—</b></div>
              <div><span>Latency</span><b id="cuLatency">—</b></div>
              <div><span>Input price</span><b id="cuInputPrice">—</b></div>
              <div><span>Output price</span><b id="cuOutputPrice">—</b></div>
            </div>
            <div class="budget-free" id="budgetFree">Контекст до ответа: —</div>
            <div class="cache-detail" id="cacheDetail"></div>
          </div>
        </div>

        <div class="chat-messages" id="chatMessages">
          <div class="empty-state">Начните диалог — сообщения сохраняются в память сразу же (level 0).</div>
        </div>
        <div class="chat-input-row">
          <button class="chat-attach-btn" id="btnAttachImage" type="button" title="Прикрепить изображение">📎</button>
          <input type="file" id="chatImageInput" accept="image/*" multiple hidden />
          <div class="chat-input-col">
            <div class="chat-attachments" id="chatAttachments"></div>
            <textarea id="chatInput" placeholder="Сообщение… (Enter — новая строка, Ctrl+Enter — отправить)"></textarea>
          </div>
          <button class="btn primary" id="btnSend">Отправить</button>
        </div>
      </div>
    </section>

    <!-- ===================== OVERVIEW ===================== -->
    <section class="view" id="view-overview">
      <h1 class="page-title">Обзор памяти</h1>
      <p class="page-sub">Состояние хранилища: сколько узлов, как распределены по уровням и пространствам, размер на диске.</p>

      <div class="grid grid-4" id="statCards"></div>

      <div class="section-title">Узлы по уровням сжатия</div>
      <div class="card">
        <div class="stack-viz" id="overviewStack" style="width:100%; height:26px;"></div>
        <div id="overviewLevelLegend" style="display:flex; gap:14px; margin-top:10px; flex-wrap:wrap;"></div>
      </div>

      <div class="section-title">Пространства (spaces)</div>
      <div class="grid grid-4" id="spaceCards"></div>

      <div class="section-title">KV-кеш и авто-сжатие</div>
      <div class="card" id="cacheStatusCard">
        <div class="empty-state">Загрузка…</div>
      </div>

      <div class="section-title">Обслуживание (ручной запуск)</div>
      <p class="page-sub" style="margin:-6px 0 10px;">Сжатие уже запускается автоматически при снижении свободного KV-кеша ниже 50% (см. выше). Кнопка ниже — для принудительного запуска вне очереди.</p>
      <div class="card" style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
        <select id="compressSpace">
          <option value="personal">personal</option>
          <option value="work">work</option>
          <option value="health">health</option>
          <option value="finance">finance</option>
          <option value="study">study</option>
          <option value="shared">shared</option>
        </select>
        <label style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-dim);">
          <input type="checkbox" id="compressForceTop" checked style="accent-color: var(--accent-live);" />
          force_top (схлопнуть до одного корня)
        </label>
        <button class="btn primary sm" id="btnCompress">Запустить сжатие</button>
        <span id="compressResult" class="mono" style="font-size:12px; color:var(--text-dim);"></span>
      </div>

      <div class="section-title">Журнал обращений к памяти (retrieval log)</div>
      <div class="card" id="retrievalLog"><div class="empty-state">Загрузка…</div></div>
    </section>

    <!-- ===================== TREE / NODE INSPECTOR ===================== -->
    <section class="view" id="view-tree">
      <h1 class="page-title">Дерево памяти</h1>
      <p class="page-sub">Слева — верхушки дерева по пространствам (можно раскрывать вниз до level 0). Справа — карточка узла.</p>

      <div class="search-row">
        <input type="text" id="searchQuery" placeholder="Полнотекстовый поиск по архиву (search_archive)…" />
        <select id="searchSpace" style="max-width:150px;">
          <option value="">все пространства</option>
          <option value="personal">personal</option>
          <option value="work">work</option>
          <option value="health">health</option>
          <option value="finance">finance</option>
          <option value="study">study</option>
          <option value="shared">shared</option>
        </select>
        <button class="btn sm" id="btnSearch">Найти</button>
      </div>
      <div id="searchResults"></div>

      <div class="explorer-layout">
        <div class="tree-panel">
          <div class="tree-toolbar">
            <select id="treeSpace">
              <option value="personal">personal</option>
              <option value="work">work</option>
              <option value="health">health</option>
              <option value="finance">finance</option>
              <option value="study">study</option>
              <option value="shared">shared</option>
            </select>
            <button class="btn sm" id="btnReloadTree">↻</button>
          </div>
          <div id="treeRoot"><div class="empty-state">Загрузка дерева…</div></div>
        </div>

        <div class="inspector" id="inspector">
          <div class="empty-state">Выберите узел слева, чтобы увидеть точное содержимое (get_fragment).</div>
        </div>
      </div>
    </section>

    <!-- ===================== PERSONAS ===================== -->
    <section class="view" id="view-personas">
      <h1 class="page-title">Персоны</h1>
      <p class="page-sub">Персона — это фильтр памяти + разрешённые инструменты + бюджет + тон. Переключение персоны не форкает архив.</p>

      <div id="personaList"><div class="empty-state">Загрузка…</div></div>

      <div class="section-title">Новая персона</div>
      <div class="card">
        <div class="grid grid-2">
          <div class="field"><label>persona_id</label><input type="text" id="npId" placeholder="напр. coach" /></div>
          <div class="field"><label>Имя</label><input type="text" id="npName" placeholder="Тренер" /></div>
        </div>
        <div class="field"><label>Описание</label><input type="text" id="npDesc" placeholder="Короткая визитка персоны" /></div>
        <div class="field"><label>system_core_addon</label><textarea id="npAddon" placeholder="Текст, добавляемый к системному ядру для этой персоны"></textarea></div>
        <div class="grid grid-2">
          <div class="field"><label>allow_spaces (через запятую)</label><input type="text" id="npAllowSpaces" placeholder="work, shared" /></div>
          <div class="field"><label>deny_spaces</label><input type="text" id="npDenySpaces" placeholder="personal, health" /></div>
        </div>
        <div class="grid grid-2">
          <div class="field"><label>Тон</label><input type="text" id="npTone" placeholder="neutral / business / warm…" /></div>
          <div class="field"><label>tool_permissions</label><select id="npTools" multiple size="4"></select></div>
        </div>
        <div class="field"><label>active_skill_ids</label><select id="npSkills" multiple size="4"></select></div>
        <button class="btn primary" id="btnCreatePersona">Создать персону</button>
      </div>
    </section>

    <!-- ===================== SKILLS ===================== -->
    <section class="view" id="view-skills">
      <h1 class="page-title">Скилы</h1>
      <p class="page-sub">Модульные инструкции: краткий триггер попадает в системный контекст, полный текст подтягивается по требованию (get_fragment / fetch_full_text). Не часть дерева памяти.</p>

      <div id="skillList"><div class="empty-state">Загрузка…</div></div>

      <div class="section-title">Новый скил</div>
      <div class="card">
        <div class="field"><label>skill_id</label><input type="text" id="nsId" placeholder="напр. daily_plan" /></div>
        <div class="field"><label>Триггер (когда использовать)</label><textarea id="nsTrigger" placeholder="Используй, когда пользователь…"></textarea></div>
        <div class="field"><label>Полная инструкция</label><textarea id="nsText" placeholder="Подробный текст, который подгружается при срабатывании скила" style="min-height:120px;"></textarea></div>
        <button class="btn primary" id="btnCreateSkill">Создать скил</button>
      </div>
    </section>

    <!-- ===================== RULES ===================== -->
    <section class="view" id="view-rules">
      <h1 class="page-title">Самогенерируемые правила</h1>
      <p class="page-sub">Жизненный цикл: draft → validated → active. Активны только правила в статусе active.</p>

      <div class="filter-row">
        <select id="rulesStatusFilter">
          <option value="">все статусы</option>
          <option value="draft">draft</option>
          <option value="validated">validated</option>
          <option value="active">active</option>
          <option value="rejected">rejected</option>
          <option value="archived">archived</option>
        </select>
        <button class="btn sm ghost" id="btnReloadRules">↻ обновить</button>
      </div>

      <div id="ruleList"><div class="empty-state">Загрузка…</div></div>

      <div class="section-title">Новое правило (draft)</div>
      <div class="card">
        <div class="field"><label>Текст правила</label><textarea id="nrText" placeholder="Напр.: Если пользователь пишет «план на день», сначала показывать незакрытые обязательства."></textarea></div>
        <div class="grid grid-3">
          <div class="field"><label>Область (scope)</label>
            <select id="nrScope">
              <option value="global">global</option>
              <option value="persona">persona</option>
              <option value="space">space</option>
              <option value="project">project</option>
            </select>
          </div>
          <div class="field"><label>persona_id (если scope=persona)</label><input type="text" id="nrPersona" /></div>
          <div class="field"><label>space_id (если scope=space/project)</label><input type="text" id="nrSpace" /></div>
        </div>
        <div class="field"><label>Контекст срабатывания (trigger_context)</label><input type="text" id="nrTrigger" placeholder="Из чего выведено правило" /></div>
        <button class="btn primary" id="btnCreateRule">Создать draft</button>
      </div>
    </section>

    <!-- ===================== FUNCTIONS ===================== -->
    <section class="view" id="view-functions">
      <h1 class="page-title">Самогенерируемые функции</h1>
      <p class="page-sub">Ассистент может предложить новую функцию сам. Предложение всегда создаётся как draft. Выполнение становится доступно только после твоего явного подтверждения.</p>

      <div class="filter-row">
        <select id="functionsStatusFilter">
          <option value="">все статусы</option>
          <option value="draft">draft</option>
          <option value="validated">validated</option>
          <option value="active">active</option>
          <option value="rejected">rejected</option>
        </select>
        <button class="btn sm ghost" id="btnReloadFunctions">↻ обновить</button>
      </div>

      <div id="functionList"><div class="empty-state">Загрузка…</div></div>

      <div class="section-title">Добавить функцию вручную (draft)</div>
      <div class="card">
        <div class="grid grid-2">
          <div class="field"><label>Имя</label><input type="text" id="nfName" placeholder="например, summarize_text" /></div>
          <div class="field"><label>Тип</label><select id="nfKind"><option value="llm_prompt">llm_prompt — функция через LLM</option><option value="http_json">http_json — HTTP API</option><option value="dynamic">dynamic — декларативная функция через LLM</option><option value="python">python — выполнение Python-кода</option><option value="python">python — выполнение Python-кода</option></select></div>
        </div>
        <div class="field"><label>Описание</label><input type="text" id="nfDescription" /></div>
        <div class="field"><label>JSON Schema параметров</label><textarea id="nfParameters">{"type":"object","properties":{}}</textarea></div>
        <div class="field"><label>Реализация (JSON)</label><textarea id="nfImplementation" placeholder='Для llm_prompt: {"prompt":"... {{args}} ..."}
Для http_json: {"url":"https://example.com/api/{{id}}","method":"GET"}
Для python: {"inline_code":"def имя_функции(...):\n    ...", "timeout_seconds":30}
Для python: {"inline_code":"def имя_функции(...):\n    ...", "timeout_seconds":30}'></textarea></div>
        <button class="btn primary" id="btnCreateFunction">Создать draft</button>
      </div>
    </section>

    <!-- ===================== USAGE ===================== -->
    <section class="view" id="view-usage">
      <h1 class="page-title">Usage / стоимость</h1>
      <p class="page-sub">Оценка токенов и стоимости по всем вызовам модели с момента запуска сервера (§18 ТЗ).</p>
      <div class="grid grid-4" id="usageCards"></div>
      <div class="grid grid-4 usage-extra-grid">
        <div class="card stat-card"><div class="stat-label">скорость генерации</div><div class="stat-value" id="usageSpeed">—</div><div class="stat-hint">output tokens / latency</div></div>
        <div class="card stat-card"><div class="stat-label">контекст последнего запроса</div><div class="stat-value" id="usageContext">—</div><div class="stat-hint" id="usageContextHint"></div></div>
        <div class="card stat-card"><div class="stat-label">reasoning tokens</div><div class="stat-value" id="usageReasoning">0</div><div class="stat-hint">включая thinking/reasoning</div></div>
        <div class="card stat-card"><div class="stat-label">cached input</div><div class="stat-value" id="usageCached">0</div><div class="stat-hint">токены из prompt cache</div></div>
      </div>
      <div class="section-title">Модели и цены OpenRouter</div>
      <div class="card usage-table-wrap" id="usageModels"></div>
      <div class="section-title">Последние запросы</div>
      <div class="card usage-table-wrap" id="usageEvents"></div>
      <div class="section-title">Вызовы по типу</div>
      <div class="card" id="usageByKind"></div>
    </section>

    <!-- ===================== ACTION LOG ===================== -->
    <section class="view" id="view-actionlog">
      <h1 class="page-title">Лог действий</h1>
      <p class="page-sub">Полная история: какие запросы ассистент отправлял модели (LLM requests) и какие инструменты/функции вызывал (tool calls), с точным содержимым запроса и ответа.</p>
      <div class="settings-row" style="margin-bottom:12px;">
        <label>Тип
          <select id="actionLogKind">
            <option value="">все</option>
            <option value="llm_request">llm_request</option>
            <option value="tool_call">tool_call</option>
          </select>
        </label>
        <label>Лимит
          <select id="actionLogLimit">
            <option value="50">50</option>
            <option value="200" selected>200</option>
            <option value="500">500</option>
          </select>
        </label>
        <button class="btn" id="actionLogRefresh">Обновить</button>
      </div>
      <div class="card usage-table-wrap" id="actionLogList"></div>
    </section>

    <!-- ===================== SETTINGS ===================== -->
    <section class="view" id="view-settings">
      <h1 class="page-title">Настройки</h1>
      <p class="page-sub">Адрес API оркестратора. По умолчанию — тот же хост, с которого открыта страница.</p>
      <div class="settings-row">
        <div class="field">
          <label>API base URL</label>
          <input type="text" id="apiBaseInput" placeholder="напр. http://localhost:8080" />
        </div>
        <button class="btn primary" id="btnSaveSettings">Сохранить</button>
        <button class="btn ghost" id="btnTestConn">Проверить</button>
      </div>
      <p class="page-sub" id="settingsStatus"></p>

      <div class="section-title" style="margin-top:28px;">LLM-провайдер</div>
      <p class="page-sub" style="margin:-6px 0 12px;">Куда оркестратор отправляет запросы к модели — свой vLMM-сервер, OpenRouter или любой другой OpenAI-совместимый endpoint. Изменения применяются сразу, без перезапуска сервера.</p>

      <div class="card" id="llmSettingsCard">
        <div class="llm-settings-grid">
          <div class="field">
            <label>Base URL</label>
            <input type="text" id="llmBaseUrl" placeholder="напр. https://openrouter.ai/api/v1" />
            <div class="field-hint">Без хвоста /chat/completions — только базовый адрес.</div>
          </div>
          <div class="field">
            <label>API-ключ</label>
            <input type="password" id="llmApiKey" placeholder="оставьте пустым, чтобы не менять" autocomplete="off" />
            <div class="field-hint" id="llmApiKeyHint"></div>
          </div>
          <div class="field field-wide">
            <label>Модель</label>
            <div class="model-row">
              <input type="text" id="llmModelManual" placeholder="выбрана: — (или введите id вручную)" readonly />
              <button class="btn ghost sm" id="btnLoadModels" type="button">Загрузить список</button>
            </div>
            <div class="field-hint" id="llmModelsHint"></div>

            <div class="model-picker" id="modelPicker" hidden>
              <div class="model-picker-toolbar">
                <input type="text" id="modelSearch" class="model-search" placeholder="поиск по id или названию…" />
                <label class="model-filter-toggle">
                  <input type="checkbox" id="modelFilterPriced" />
                  только с ценой
                </label>
              </div>
              <div class="model-table-head" id="modelTableHead">
                <span class="mt-col mt-id" data-sort="id">Модель <span class="sort-ico"></span></span>
                <span class="mt-col mt-price" data-sort="price_prompt_per_1m">Вход $/1М <span class="sort-ico"></span></span>
                <span class="mt-col mt-price" data-sort="price_completion_per_1m">Выход $/1М <span class="sort-ico"></span></span>
                <span class="mt-col mt-ctx" data-sort="context_length">Контекст <span class="sort-ico"></span></span>
              </div>
              <div class="model-table-body" id="modelTableBody"></div>
            </div>
          </div>
          <div class="field">
            <label>Site URL <span class="opt-tag">опционально</span></label>
            <input type="text" id="llmSiteUrl" placeholder="для атрибуции на OpenRouter" />
          </div>
          <div class="field">
            <label>Site Name <span class="opt-tag">опционально</span></label>
            <input type="text" id="llmSiteName" placeholder="только латиницей" />
          </div>
        </div>

        <div class="section-title" style="margin-top:20px; font-size:14px;">Параметры генерации</div>
        <p class="page-sub" style="margin:-4px 0 12px;">Применяются к каждому запросу к модели.</p>
        <div class="llm-settings-grid">
          <div class="field">
            <label>Temperature <span class="opt-tag">0–2</span></label>
            <input type="number" id="llmTemperature" min="0" max="2" step="0.05" placeholder="0.3" />
            <div class="field-hint">Ниже — более предсказуемые ответы, выше — более разнообразные.</div>
          </div>
          <div class="field">
            <label>Max tokens</label>
            <input type="number" id="llmMaxTokens" min="1" max="32768" step="1" placeholder="1024" />
            <div class="field-hint">Максимальная длина ответа модели в токенах.</div>
          </div>
          <div class="field">
            <label>Top P <span class="opt-tag">опционально</span></label>
            <input type="number" id="llmTopP" min="0" max="1" step="0.05" placeholder="не задано — по умолчанию провайдера" />
            <div class="field-hint">Оставьте пустым, чтобы не отправлять параметр вовсе.</div>
          </div>
        </div>

        <div class="section-title" style="margin-top:20px; font-size:14px;">Продвинутые параметры</div>
        <p class="page-sub" style="margin:-4px 0 12px;">Для опытных пользователей — дополнительные настройки поведения модели.</p>
        <div class="llm-settings-grid">
          <div class="field">
            <label>Context window <span class="opt-tag">токены</span></label>
            <input type="number" id="llmContextWindow" min="1024" max="200000" step="1024" placeholder="8192" />
            <div class="field-hint">Размер контекстного окна модели. Обычно определяется автоматически.</div>
          </div>
          <div class="field">
            <label>Max tool iterations <span class="opt-tag">фаз</span></label>
            <input type="number" id="llmMaxToolIterations" min="1" max="50" step="1" placeholder="10" />
            <div class="field-hint">Максимум циклов «план → выполнение пула → анализ». Внутри одного пула все независимые функции выполняются до следующего обращения к модели.</div>
          </div>
          <div class="field">
            <label>Top K <span class="opt-tag">опционально</span></label>
            <input type="number" id="llmTopK" min="1" placeholder="не задано — по умолчанию провайдера" />
            <div class="field-hint">Рассматривает только top K наиболее вероятных токенов при выборе следующего.</div>
          </div>
          <div class="field">
            <label>Frequency penalty <span class="opt-tag">опционально, -2 до 2</span></label>
            <input type="number" id="llmFrequencyPenalty" min="-2" max="2" step="0.1" placeholder="0" />
            <div class="field-hint">Штраф за повторение похожих токенов, которые уже были.</div>
          </div>
          <div class="field">
            <label>Presence penalty <span class="opt-tag">опционально, -2 до 2</span></label>
            <input type="number" id="llmPresencePenalty" min="-2" max="2" step="0.1" placeholder="0" />
            <div class="field-hint">Штраф за появление новых токенов, которые ещё не были в ответе.</div>
          </div>
        </div>

        <div class="section-title" style="margin-top:20px; font-size:14px;">Ризонинг (thinking tokens)</div>
        <p class="page-sub" style="margin:-4px 0 12px;">Для моделей вроде openai/gpt-oss-120b на OpenRouter — запрашивает и показывает в чате цепочку рассуждений модели перед финальным ответом. Игнорируется провайдерами/моделями, которые этого не поддерживают.</p>
        <div class="llm-settings-grid">
          <div class="field">
            <label class="reasoning-toggle" style="font-size:13px;">
              <input type="checkbox" id="llmReasoningEnabled" />
              Включить ризонинг по умолчанию
            </label>
            <div class="field-hint">Можно также переключать прямо в чате — этот флажок задаёт значение по умолчанию.</div>
          </div>
          <div class="field">
            <label>Уровень усилий (effort)</label>
            <select id="llmReasoningEffort" class="reasoning-effort-select" style="width:100%;">
              <option value="low">low — быстрее, меньше токенов на размышление</option>
              <option value="medium" selected>medium</option>
              <option value="high">high — медленнее, подробнее</option>
            </select>
          </div>
        </div>
        <div class="llm-settings-actions">
          <button class="btn primary" id="btnSaveLlmSettings">Сохранить и применить</button>
          <span class="llm-status-pill" id="llmStatusPill"></span>
        </div>
        <p class="page-sub" id="llmSettingsStatus" style="margin-top:8px;"></p>
      </div>
    </section>

  </div>
</div>

<div class="toast-stack" id="toastStack"></div>

<script>
(function () {
  // Android Chrome keyboard fix: dvh doesn't reliably shrink for the
  // on-screen keyboard, so track visualViewport.height ourselves and
  // expose it as --vvh. Also nudge the focused input into view since
  // some keyboards report the resize a frame late.
  var vv = window.visualViewport;
  if (!vv) return;

  function setVvh() {
    document.documentElement.style.setProperty("--vvh", vv.height + "px");
  }
  setVvh();
  vv.addEventListener("resize", setVvh);
  vv.addEventListener("scroll", setVvh);

  document.addEventListener("focusin", function (e) {
    var t = e.target;
    if (t && (t.tagName === "TEXTAREA" || t.tagName === "INPUT")) {
      setTimeout(function () {
        t.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }, 60);
    }
  });
})();
</script>
<script src="/static/app.js?v=__BUILD__"></script>
<div style="position:fixed;right:12px;bottom:12px;z-index:1000;"><label><input type="checkbox" id="hideToolCalls"> Скрыть функции</label></div></body>
</html>
